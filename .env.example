# files.gg production configuration (docs/redesign/contracts/milestone-7.md §2.3). Copy to .env next to
# docker-compose.yml (never committed), replace every CHANGE_ME, and run `ops/check-env.sh`: it refuses a deploy while
# a required value is missing or still a placeholder. Commented-out lines are optional, shown with their default.
#
# Generated secrets: `openssl rand -hex 32` each, a different one per variable. Shared with the Cloudflare Worker (set
# there with `npx wrangler secret put <NAME>` in cf-worker/, the same value): ORIGIN_SHARED_SECRET, CDN_SIGNING_SECRET.
# Changing ABUSE_HASH_SECRET makes every ban and IP hash useless; changing SECRET_KEY signs everyone out.

# --- every API process (api, migrate, worker, scanner, rescanner, the converters) -----------------------------------

# the public origins written into links and emails; another deployment (staging) sets its own
# PUBLIC_URL=https://files.gg
# CDN_URL=https://cdn.files.gg
# API_PUBLIC_URL=https://api.files.gg

POSTGRES_PASSWORD=CHANGE_ME
# Overrides, only when Postgres or Redis live on another host:
# DATABASE_URL=postgresql://filesgg:<password>@postgres:5432/filesgg
# REDIS_URL=redis://:<password>@redis:6379/0

SECRET_KEY=CHANGE_ME
RPC_KEY=CHANGE_ME
ORIGIN_SHARED_SECRET=CHANGE_ME
VIEW_HASH_SECRET=CHANGE_ME
CDN_SIGNING_SECRET=CHANGE_ME
ABUSE_HASH_SECRET=CHANGE_ME
# Redis's password (the redis service and every client); hex only, it goes into URLs
REDIS_PASSWORD=CHANGE_ME

# Postmark: the server's API token (Postmark > Servers > files.gg > API Tokens), sending from mail.files.gg
POSTMARK_SERVER_TOKEN=CHANGE_ME
# EMAIL_FROM=files.gg <noreply@mail.files.gg>

# Cloudflare Turnstile (dashboard > Turnstile > files.gg): the secret key here, the site key further down
TURNSTILE_SECRET=CHANGE_ME
# TURNSTILE_HOSTNAMES=files.gg

# The B2 files bucket (US region), with an application key that can read, write and delete in it. The CDN Worker
# reads with its own read-only key (its S3_READ_* secrets).
S3_ENDPOINT=CHANGE_ME
S3_REGION=CHANGE_ME
S3_BUCKET_FILES=CHANGE_ME
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME

# Child safety (milestone-4): PhotoDNA is the only matcher in production
CSAM_MATCHER=photodna
# The evidence key pair's public key (base64). Made once, offline, by the child-safety lead, who keeps the private
# key off every server:
#   python3 -c "import base64; from nacl.public import PrivateKey; k = PrivateKey.generate(); \
#     print('public', base64.b64encode(bytes(k.public_key)).decode()); print('private', base64.b64encode(bytes(k)).decode())"
EVIDENCE_PUBLIC_KEY=CHANGE_ME
# NSFW_THRESHOLD=0.85

# Discord sign-in, optional (discord.com/developers > the files.gg application > OAuth2; the redirect must be registered
# there). Leave all three empty and Discord sign-in is off: its sign-in, link and re-auth buttons aren't shown.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# Custom domains (Cloudflare for SaaS): an API token with only "SSL and Certificates: Edit" on the files.gg zone
# (milestone-6 §17), and the zone's id
CLOUDFLARE_API_TOKEN=CHANGE_ME
CLOUDFLARE_ZONE_ID=CHANGE_ME
# CUSTOM_DOMAIN_TARGET=domains.files.gg

# Cloudflare's request-body limit for the zone (100 MiB below Enterprise); nginx's client_max_body_size is this plus
# 1 MiB, change both together (ops/check-env.sh compares them)
# PROXY_BODY_LIMIT_BYTES=104857600
# Rate-limit overrides, JSON (milestone-5 §18); empty keeps the defaults
# RATE_LIMITS=

# --- scanner and rescanner ------------------------------------------------------------------------------------------

# PhotoDNA (Microsoft's Content Moderator subscription key)
PHOTODNA_SUBSCRIPTION_KEY=CHANGE_ME
# PHOTODNA_MATCH_URL=https://api.microsoftmoderator.com/photodna/v1.0/Match
# PHOTODNA_TIMEOUT=10
# PHOTODNA_MAX_RPS=5
# Google Web Risk (Cloud console > APIs > Web Risk API > an API key restricted to it)
WEB_RISK_API_KEY=CHANGE_ME
# The Object Lock evidence bucket (compliance mode), and a key that can write and copy into it and read the files
# bucket, but can't read or delete evidence
S3_BUCKET_EVIDENCE=CHANGE_ME
S3_EVIDENCE_ACCESS_KEY_ID=CHANGE_ME
S3_EVIDENCE_SECRET_ACCESS_KEY=CHANGE_ME
# EVIDENCE_RETENTION_DAYS=365

# --- converter-premium, converter, converter-previews, office -------------------------------------------------------

# CONVERTER_PREMIUM_PROCESSES=2
# CONVERTER_PREMIUM_CPUS=4
# CONVERTER_PREMIUM_THREADS=
# CONVERTER_PROCESSES=4
# CONVERTER_CPUS=4
# CONVERTER_THREADS=
# CONVERTER_PREVIEW_PROCESSES=1
# CONVERTER_PREVIEW_CPUS=1
# CONVERTER_PREVIEW_THREADS=
# CONVERTER_TMP_SIZE=8g
# OFFICE_PROCESSES=2
# OFFICE_TIMEOUT=120

# --- backup-db (backup/README.md) -----------------------------------------------------------------------------------

# restic's repository password: without it the backups can't be decrypted, keep a copy off this server
DB_BACKUP_RESTIC_PASSWORD=CHANGE_ME
# a backup-only B2 key on the backups bucket (same S3_ENDPOINT as above)
S3_BACKUP_ACCESS_KEY_ID=CHANGE_ME
S3_BACKUP_SECRET_ACCESS_KEY=CHANGE_ME
# S3_BUCKET_DB_BACKUP=filesgg-db-backups
# healthchecks.io: the daily backup pings it, and it alerts when a day is missed (milestone-7 §4.3)
DB_BACKUP_HEALTHCHECK_URL=CHANGE_ME
# empty keeps backup.sh's defaults (14 daily, unlimited weekly, 0 monthly, 0 yearly)
# DB_BACKUP_KEEP_DAILY=
# DB_BACKUP_KEEP_WEEKLY=
# DB_BACKUP_KEEP_MONTHLY=
# DB_BACKUP_KEEP_YEARLY=

# --- grafana --------------------------------------------------------------------------------------------------------

GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Discord channel > Edit > Integrations > Webhooks > New webhook > Copy URL
GRAFANA_ALERT_DISCORD_WEBHOOK=CHANGE_ME

# --- ops/deploy.sh: the web build and the Cloudflare Worker (not read by compose) ----------------------------------

# Turnstile's public site key, built into the website
VITE_TURNSTILE_SITE_KEY=CHANGE_ME
# For `wrangler deploy`: an API token with Workers Scripts:Edit and Workers Routes:Edit, and the account's id. Empty
# uses `npx wrangler login` of the deploying user instead. The Worker also gets S3_ENDPOINT, S3_REGION and
# S3_BUCKET_FILES from above; its secrets are set once with `npx wrangler secret put` (cf-worker/wrangler.toml).
# WORKER_DEPLOY_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# The wrangler environment: empty is the production Worker; the staging run's .env sets `staging` (cf-worker/wrangler.toml)
# WORKER_ENV=

# --- the staging run only (docs/redesign/LAUNCH.md §7), never in production -----------------------------------------

# more host names nginx serves the API on, space-separated (ops/check-env.sh refuses it with production's PUBLIC_URL)
# NGINX_EXTRA_API_HOSTS=api-staging.files.gg

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Typescript v1 declaration files
typings/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.*
!.env.example


# Production database dumps: personal data, never commit (see docs/redesign/PLAN.md)
db-dumps/
*.dump

# Local data written by docker-compose.yml (postgres data, restic cache, restored dumps), as in notsobot.api
.data/
.cache/
.restore/

# macOS Finder metadata
.DS_Store

# ops/deploy.sh's lock and deploy history (milestone-7 §3.2)
.deploy/

# the Cloudflare origin certificate and its key, put on the server by hand (milestone-7 §2.2); the origin-pull CA next
# to them is public and committed
nginx/certificates/certificate.cert
nginx/certificates/certificate.key

      "css": ".ds-nav{font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;display:flex;flex-direction:column;gap:2px;width:232px;padding:12px;background:var(--surface,#2b2d31);border-radius:16px;}.ds-nav-head{margin:0;padding:0 12px 4px;font-size:11px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:color-mix(in srgb,var(--muted,#b5bac1) 80%,transparent);}.ds-nav-item{display:flex;align-items:center;gap:12px;height:40px;padding:0 12px;border-radius:12px;font-size:14px;color:var(--muted,#b5bac1);text-decoration:none;transition:background-color .15s,color .15s;}.ds-nav-item:hover{background:color-mix(in srgb,var(--surface-2,#313338) 60%,transparent);color:var(--text,#f2f3f5);}.ds-nav-item[aria-current=page]{background:var(--surface-2,#313338);color:var(--text,#f2f3f5);}.ds-nav-item[aria-current=page] svg{color:var(--gg,#3deb7e);}.ds-nav-item:focus-visible{outline:2px solid var(--gg,#3deb7e);outline-offset:2px;}"

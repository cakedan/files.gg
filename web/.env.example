# Base URL for the files.gg API. In `npm run dev`, leaving it unset uses the in-memory
# mock API (mock-api.ts) at /__mock-api. Builds default to https://api.files.gg.
# VITE_API_URL=https://api.files.gg

# Public Turnstile site key (contract §8). Required for production builds.
# Dev and tests default to Cloudflare's always-pass testing key 1x00000000000000000000AA.
# VITE_TURNSTILE_SITE_KEY=
